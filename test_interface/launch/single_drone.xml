<launch>
    <arg name="drone_id"/>
    <arg name="uav_num_"/>
    <arg name="init_x_"/>
    <arg name="init_y_"/>
    <arg name="init_z_"/>
    <arg name="init_yaw"/>
    <arg name="odom_topic"/>
    <arg name="lidar_type"/>
    <arg name="map_name_"/>
    <arg name="downsample_resolution_"/>
    <arg name="use_gpu"/>
    <arg name="use_uav_extra_model_"/>
    <arg name="vehicle_profile" default="marsim_default"/>
    <arg name="mass" default="$(eval 0.716 if arg('vehicle_profile') == 'predictnav_hummingbird' else 1.9)"/>
    <arg name="inertia_diag" default="$(eval '[0.007, 0.007, 0.012]' if arg('vehicle_profile') == 'predictnav_hummingbird' else '[0.03, 0.03, 0.06]')"/>
    <arg name="mesh_resource" default="package://odom_visualization/meshes/hummingbird.mesh"/>
    <!-- controller_type: pid (default, bit-for-bit cascadePID_node)
                          so3 (Lee 2010 geometric controller)
                          ctbr (high-rate CTBR tracker with hold fallback)
                          none (skip stock controller; bridge owns /cmdRPM) -->
    <arg name="controller_type" default="pid"/>
    <arg name="wait_for_first_command" default="false"/>
    <!-- Branch 3: sensor_type selects GPU renderer mode.
         "lidar"         — polar 360camera.vs, behaviour byte-identical to pre-merge (default).
         "depth_pinhole" — standard pinhole camera.vs/fs, publishes 32FC1 metric depth +
                           CameraInfo.  Effective only when use_gpu:=true. -->
    <arg name="sensor_type"         default="lidar"/>
    <arg name="image_width"         default="160"/>
    <arg name="image_height"        default="96"/>
    <arg name="fx"                  default="80.0"/>
    <arg name="fy"                  default="83.14"/>
    <arg name="cx"                  default="80.0"/>
    <arg name="cy"                  default="48.0"/>
    <arg name="near_clip"           default="0.1"/>
    <arg name="far_clip"            default="30.0"/>
    <arg name="use_gaussian_filter" default="0"/>

       <!-- <node pkg="bubble_planner" type="planning" name="quad_$(arg drone_id)_planner" output="screen">
           <rosparam command="load" file="$(find bubble_planner)/config/advanced_params.yaml"/>
           <remap from="~odom" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>
           <remap from="~position_cmd" to="/quad_$(arg drone_id)/planning/pos_cmd"/>
           <remap from="~global_map" to="/map_generator/global_cloud"/>
           <param name="drone_id" value="$(arg drone_id)"/>
           <remap from="/goal" to="/mission_planner/goal"/>
       </node> -->

    <!-- <node pkg="poly_planner" type="fsm_node" name="quad_$(arg drone_id)_planner" output="screen">
        <rosparam command="load" file="$(find poly_planner)/config/yunque.yaml"/>
        <remap from="~odom" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>
        <remap from="/goal" to="/goal"/>
        <remap from="/position_cmd" to="/quad_$(arg drone_id)/planning/pos_cmd"/>
        <remap from="~cloud" to="/quad$(arg drone_id)_pcl_render_node/cloud"/>
        <param name="fsm/drone_id" value="$(arg drone_id)"/>
    </node> -->

    <node pkg="mars_drone_sim" name="quad$(arg drone_id)_quadrotor_dynamics" type="quadrotor_dynamics_node"
          output="log">
        <remap from="~odom" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>
        <remap from="~cmd_RPM" to="/quad_$(arg drone_id)/cmdRPM"/>
        <remap from="~imu" to="/quad_$(arg drone_id)/imu"/>
        <param name="vehicle_profile" value="$(arg vehicle_profile)"/>
        <param name="mass" value="$(arg mass)"/>
        <rosparam subst_value="true" param="inertia_diag">$(arg inertia_diag)</rosparam>
        <param name="simulation_rate" value="200"/>
        <param name="wait_for_first_command" value="$(arg wait_for_first_command)"/>
        <param name="quadrotor_name" value="quad_$(arg drone_id)"/>
        <param name="init_state_x" value="$(arg init_x_)"/>
        <param name="init_state_y" value="$(arg init_y_)"/>
        <param name="init_state_z" value="$(arg init_z_)"/>
    </node>

    <group if="$(eval arg('controller_type') == 'pid')">
        <node pkg="cascadePID" name="quad$(arg drone_id)_cascadePID_node" type="cascadePID_node" >
            <param name="drone_id" value="$(arg drone_id)"/>
            <remap from="~odom" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>
            <remap from="~cmd_RPM" to="/quad_$(arg drone_id)/cmdRPM"/>
            <remap from="~cmd_pose" to="/goal"/>
            <!--/quad_$(arg drone_id)/pos_cmd  -->
            <remap from="~position_cmd" to="/quad_$(arg drone_id)/planning/pos_cmd"/>
            <param name="controller_rate" value="200"/>
            <param name="quadrotor_name" value="quad_$(arg drone_id)"/>
            <param name="init_state_x" value="$(arg init_x_)"/>
            <param name="init_state_y" value="$(arg init_y_)"/>
            <param name="init_state_z" value="$(arg init_z_)"/>
            <param name="init_state_yaw" value="$(arg init_yaw)"/>
            <param name="angle_stable_time" value="0.5"/>
            <param name="damping_ratio" value="1.0"/>
        </node>
    </group>

    <group if="$(eval arg('controller_type') == 'so3')">
        <node pkg="cascadePID" name="quad$(arg drone_id)_so3_controller_node" type="so3_controller_node">
            <remap from="~odom" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>
            <remap from="~cmd_RPM" to="/quad_$(arg drone_id)/cmdRPM"/>
            <remap from="~position_cmd" to="/quad_$(arg drone_id)/planning/pos_cmd"/>
            <param name="controller_rate" value="200"/>
            <param name="init_state_x" value="$(arg init_x_)"/>
            <param name="init_state_y" value="$(arg init_y_)"/>
            <param name="init_state_z" value="$(arg init_z_)"/>
            <!-- Aligned with quadrotor_dynamics_node (1.9) and cascadePID (1.9). -->
            <param name="vehicle_profile" value="$(arg vehicle_profile)"/>
            <param name="mass" value="$(arg mass)"/>
            <rosparam param="k_x">[7.0, 7.0, 11.0]</rosparam>
            <rosparam param="k_v">[4.0, 4.0, 7.0]</rosparam>
            <rosparam param="k_R">[1.5, 1.5, 0.5]</rosparam>
            <rosparam param="k_Omega">[0.3, 0.3, 0.15]</rosparam>
            <rosparam subst_value="true" param="inertia_diag">$(arg inertia_diag)</rosparam>
        </node>
    </group>

    <group if="$(eval arg('controller_type') == 'ctbr')">
        <node pkg="cascadePID" name="quad$(arg drone_id)_ctbr_controller_node" type="ctbr_controller_node">
            <remap from="~odom" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>
            <remap from="~ctbr_cmd" to="/quad_$(arg drone_id)/control/ctbr_cmd"/>
            <remap from="~cmd_RPM" to="/quad_$(arg drone_id)/cmdRPM"/>
            <param name="controller_rate" value="200"/>
            <param name="ctbr_timeout" value="0.15"/>
            <param name="init_state_x" value="$(arg init_x_)"/>
            <param name="init_state_y" value="$(arg init_y_)"/>
            <param name="init_state_z" value="$(arg init_z_)"/>
            <param name="vehicle_profile" value="$(arg vehicle_profile)"/>
            <param name="mass" value="$(arg mass)"/>
            <rosparam param="k_x">[7.0, 7.0, 11.0]</rosparam>
            <rosparam param="k_v">[4.0, 4.0, 7.0]</rosparam>
            <rosparam param="k_R">[1.5, 1.5, 0.5]</rosparam>
            <rosparam param="k_Omega">[0.3, 0.3, 0.15]</rosparam>
            <rosparam subst_value="true" param="inertia_diag">$(arg inertia_diag)</rosparam>
        </node>
    </group>

    <node pkg="odom_visualization" name="quad$(arg drone_id)_odom_visualization" type="odom_visualization"
          output="screen">
        <remap from="~odom" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>
        <remap from="~cmd" to="/quad_$(arg drone_id)/pos_cmd"/>
        <param name="init_x" value="$(arg init_x_)"/>
        <param name="init_y" value="$(arg init_y_)"/>
        <param name="init_z" value="$(arg init_z_)"/>
        <param name="color/a" value="1.0"/>
        <param name="color/r" value="0.0"/>
        <param name="color/g" value="1.0"/>
        <param name="color/b" value="1.0"/>
        <param name="covariance_scale" value="100.0"/>
        <param name="robot_scale" value="1.0"/>
        <param name="quadrotor_name" value="quad$(arg drone_id)"/>
        <param name="drone_id" value="$(arg drone_id)"/>
        <param name="mesh_resource" value="$(arg mesh_resource)"/>
    </node>

    <group if="$(arg use_gpu)">

        <group if="$(eval lidar_type == 'avia')">
            <node pkg="local_sensing_node" type="opengl_render_node" name="quad$(arg drone_id)_pcl_render_node" output="screen"
                args="$(arg map_name_)">
            <remap from="~global_map" to="/map_generator/global_cloud"/>
            <remap from="~odometry" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>

            <param name="drone_id" value="$(arg drone_id)"/>
            <param name="quadrotor_name" value="quad_$(arg drone_id)"/>
            <param name="uav_num" value="$(arg uav_num_)"/>
            <param name="is_360lidar" value="0"/>
            <param name="sensing_horizon" value="30.0"/>
            <param name="sensing_rate" value="10.0"/>
            <param name="estimation_rate" value="10.0"/>
            <param name="polar_resolution" value="0.2"/>
            <param name="yaw_fov" value="70.4"/>
            <param name="vertical_fov" value="77.2"/>
            <param name="min_raylength" value="1.0"/>
            <param name="livox_linestep" value="1.4"/>
            <param name="curvature_limit" value="100.0"/>
            <param name="hash_cubesize" value="5.0"/>
            <param name="use_avia_pattern" value="1"/>

            <param name="downsample_res" value="$(arg downsample_resolution_)"/>

            <param name="dynobj_enable" value="0"/>
            <param name="dynobject_size" value="0.8"/>
            <param name="dynobject_num" value="10"/>
            <param name="dyn_mode" value="0"/><!-- 0 for a=0, 1 for a=g, 2 for random walk -->
            <param name="dyn_velocity" value="1.0"/>

            <param name="use_uav_extra_model" value="$(arg use_uav_extra_model_)"/>

            <!-- collision parameter -->
            <param name="collisioncheck_enable" value="0"/>
            <param name="collision_range" value="0.3"/>

            <param name="output_pcd" value="0"/>

            <!-- Branch 3: pinhole depth mode params.
                 When sensor_type=lidar (default), all pinhole params are read but ignored. -->
            <param name="sensor_type"         value="$(arg sensor_type)"/>
            <param name="image_width"         value="$(arg image_width)"/>
            <param name="image_height"        value="$(arg image_height)"/>
            <param name="fx"                  value="$(arg fx)"/>
            <param name="fy"                  value="$(arg fy)"/>
            <param name="cx"                  value="$(arg cx)"/>
            <param name="cy"                  value="$(arg cy)"/>
            <param name="near_clip"           value="$(arg near_clip)"/>
            <param name="far_clip"            value="$(arg far_clip)"/>
            <param name="use_gaussian_filter" value="$(arg use_gaussian_filter)"/>

            <remap from="~depth_img" to="/quad$(arg drone_id)/depth/image_raw"/>
            <remap from="~camera_info" to="/quad$(arg drone_id)/depth/camera_info"/>

        </node>
        </group>

        <group if="$(eval lidar_type == 'mid360')">
            <node pkg="local_sensing_node" type="opengl_render_node" name="quad$(arg drone_id)_pcl_render_node" output="screen" 
                args="$(arg map_name_)">
                <remap from="~global_map" to="/map_generator/global_cloud"/>
                <remap from="~odometry" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>

                <param name="drone_id" value="$(arg drone_id)"/>
                <param name="quadrotor_name" value="quad_$(arg drone_id)"/>
                <param name="uav_num" value="$(arg uav_num_)"/>
                <param name="is_360lidar" value="1"/>
                <param name="sensing_horizon" value="15.0"/>
                <param name="sensing_rate" value="10.0"/>
                <param name="estimation_rate" value="10.0"/>
                <param name="polar_resolution" value="0.2"/>
                <param name="yaw_fov" value="360.0"/>
                <param name="vertical_fov" value="90.0"/>
                <param name="min_raylength" value="1.0"/>
                <param name="livox_linestep" value="1.4"/>
                <param name="curvature_limit" value="100.0"/>
                <param name="hash_cubesize" value="5.0"/>
                <param name="use_avia_pattern" value="0"/>
                <param name="use_vlp32_pattern" value="0"/>
                <param name="use_minicf_pattern" value="1"/>

                <param name="downsample_res" value="$(arg downsample_resolution_)"/>

                <param name="dynobj_enable" value="0"/>
                <param name="dynobject_size" value="0.8"/>
                <param name="dynobject_num" value="10"/>
                <param name="dyn_mode" value="0"/><!-- 0 for a=0, 1 for a=g, 2 for random walk -->
                <param name="dyn_velocity" value="1.0"/>

                <param name="use_uav_extra_model" value="$(arg use_uav_extra_model_)"/>

                <!-- collision parameter -->
                <param name="collisioncheck_enable" value="0"/>
                <param name="collision_range" value="0.3"/>
                <param name="output_pcd" value="0"/>
            </node>
        </group>

        <group if="$(eval lidar_type == 'os128')">
            <node pkg="local_sensing_node" type="opengl_render_node" name="quad$(arg drone_id)_pcl_render_node" output="screen" 
                args="$(arg map_name_)">
                <remap from="~global_map" to="/map_generator/global_cloud"/>
                <remap from="~odometry" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>

                <param name="drone_id" value="$(arg drone_id)"/>
                <param name="quadrotor_name" value="quad_$(arg drone_id)"/>
                <param name="uav_num" value="$(arg uav_num_)"/>
                <param name="is_360lidar" value="1"/>
                <param name="sensing_horizon" value="15.0"/>
                <param name="sensing_rate" value="10.0"/>
                <param name="estimation_rate" value="10.0"/>
                <param name="polar_resolution" value="0.2"/>
                <param name="yaw_fov" value="360.0"/>
                <param name="vertical_fov" value="60.0"/>
                <param name="min_raylength" value="1.0"/>
                <param name="livox_linestep" value="1.4"/>
                <param name="curvature_limit" value="100.0"/>
                <param name="hash_cubesize" value="5.0"/>
                <param name="use_avia_pattern" value="0"/>
                <param name="use_vlp32_pattern" value="0"/>
                <param name="use_minicf_pattern" value="0"/>
                <param name="use_os128_pattern" value="1"/>

                <param name="downsample_res" value="$(arg downsample_resolution_)"/>

                <param name="dynobj_enable" value="0"/>
                <param name="dynobject_size" value="0.8"/>
                <param name="dynobject_num" value="10"/>
                <param name="dyn_mode" value="0"/><!-- 0 for a=0, 1 for a=g, 2 for random walk -->
                <param name="dyn_velocity" value="1.0"/>

                <param name="use_uav_extra_model" value="$(arg use_uav_extra_model_)"/>

                <!-- collision parameter -->
                <param name="collisioncheck_enable" value="0"/>
                <param name="collision_range" value="0.3"/>
                <param name="output_pcd" value="0"/>
            </node>
        </group>

    </group>

    <group unless="$(arg use_gpu)">
        <!-- Livox Avia launch-prefix="gdb -ex run -args" -->
        <group if="$(eval lidar_type == 'avia')">
            <node pkg="local_sensing_node" type="pcl_render_node" name="quad$(arg drone_id)_pcl_render_node"
                output="screen">
                <remap from="~global_map" to="/map_generator/global_cloud"/>
                <remap from="~odometry" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>

                <param name="drone_id" value="$(arg drone_id)"/>
                <param name="quadrotor_name" value="quad_$(arg drone_id)"/>
                <param name="uav_num" value="$(arg uav_num_)"/>
                <param name="is_360lidar" value="0"/>
                <param name="sensing_horizon" value="30.0"/>
                <param name="sensing_rate" value="10.0"/>
                <param name="estimation_rate" value="10.0"/>
                <param name="polar_resolution" value="0.2"/>
                <param name="yaw_fov" value="70.4"/>
                <param name="vertical_fov" value="77.2"/>
                <param name="min_raylength" value="1.0"/>
                <param name="livox_linestep" value="1.4"/>
                <param name="curvature_limit" value="100.0"/>
                <param name="hash_cubesize" value="5.0"/>
                <param name="use_avia_pattern" value="1"/>

                <param name="downsample_res" value="$(arg downsample_resolution_)"/>

                <param name="dynobj_enable" value="0"/>
                <param name="dynobject_size" value="0.8"/>
                <param name="dynobject_num" value="10"/>
                <param name="dyn_mode" value="0"/><!-- 0 for a=0, 1 for a=g, 2 for random walk -->
                <param name="dyn_velocity" value="1.0"/>

                <param name="use_uav_extra_model" value="$(arg use_uav_extra_model_)"/>

                <!-- collision parameter -->
                <param name="collisioncheck_enable" value="0"/>
                <param name="collision_range" value="0.3"/>

                <param name="output_pcd" value="0"/>
            </node>

        </group>


        <!-- VLP-32 -->
launch-prefix="gdb --ex run -args"
        <group if="$(eval lidar_type == 'mid360')">
            <node pkg="local_sensing_node" type="pcl_render_node"
                name="quad$(arg drone_id)_pcl_render_node" output="screen"> <!--  -->
                <remap from="~global_map" to="/map_generator/global_cloud"/>
                <remap from="~odometry" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>

                <param name="drone_id" value="$(arg drone_id)"/>
                <param name="quadrotor_name" value="quad_$(arg drone_id)"/>
                <param name="uav_num" value="$(arg uav_num_)"/>
                <param name="is_360lidar" value="1"/>
                <param name="sensing_horizon" value="15.0"/>
                <param name="sensing_rate" value="10.0"/>
                <param name="estimation_rate" value="10.0"/>
                <param name="polar_resolution" value="0.2"/>
                <param name="yaw_fov" value="360.0"/>
                <param name="vertical_fov" value="90.0"/>
                <param name="min_raylength" value="1.0"/>
                <param name="livox_linestep" value="1.4"/>
                <param name="curvature_limit" value="100.0"/>
                <param name="hash_cubesize" value="5.0"/>
                <param name="use_avia_pattern" value="0"/>
                <param name="use_vlp32_pattern" value="0"/>
                <param name="use_minicf_pattern" value="1"/>

                <param name="downsample_res" value="$(arg downsample_resolution_)"/>

                <param name="dynobj_enable" value="0"/>
                <param name="dynobject_size" value="0.6"/>
                <param name="dynobject_num" value="30"/>
                <param name="dyn_mode" value="2"/><!-- 0 for a=0, 1 for a=g, 2 for random walk -->
                <param name="dyn_velocity" value="3.0"/>

                <param name="use_uav_extra_model" value="$(arg use_uav_extra_model_)"/>

                <!-- collision parameter -->
                <param name="collisioncheck_enable" value="0"/>
                <param name="collision_range" value="0.3"/>
                <param name="output_pcd" value="0"/>
            </node>
        </group>        

        <group if="$(eval lidar_type == 'os128')">
            <node pkg="local_sensing_node" type="pcl_render_node"
                name="quad$(arg drone_id)_pcl_render_node" output="screen"> <!--  -->
                <remap from="~global_map" to="/map_generator/global_cloud"/>
                <remap from="~odometry" to="/quad_$(arg drone_id)/$(arg odom_topic)"/>

                <param name="drone_id" value="$(arg drone_id)"/>
                <param name="quadrotor_name" value="quad_$(arg drone_id)"/>
                <param name="uav_num" value="$(arg uav_num_)"/>
                <param name="is_360lidar" value="1"/>
                <param name="sensing_horizon" value="15.0"/>
                <param name="sensing_rate" value="10.0"/>
                <param name="estimation_rate" value="10.0"/>
                <param name="polar_resolution" value="0.2"/>
                <param name="yaw_fov" value="360.0"/>
                <param name="vertical_fov" value="60.0"/>
                <param name="min_raylength" value="1.0"/>
                <param name="livox_linestep" value="1.4"/>
                <param name="curvature_limit" value="100.0"/>
                <param name="hash_cubesize" value="5.0"/>
                <param name="use_avia_pattern" value="0"/>
                <param name="use_vlp32_pattern" value="0"/>
                <param name="use_minicf_pattern" value="0"/>
                <param name="use_os128_pattern" value="1"/>

                <param name="downsample_res" value="$(arg downsample_resolution_)"/>

                <param name="dynobj_enable" value="0"/>
                <param name="dynobject_size" value="0.8"/>
                <param name="dynobject_num" value="10"/>
                <param name="dyn_mode" value="0"/><!-- 0 for a=0, 1 for a=g, 2 for random walk -->
                <param name="dyn_velocity" value="1.0"/>

                <param name="use_uav_extra_model" value="$(arg use_uav_extra_model_)"/>

                <!-- collision parameter -->
                <param name="collisioncheck_enable" value="0"/>
                <param name="collision_range" value="0.3"/>
                <param name="output_pcd" value="0"/>

            </node>
        </group>        
    </group>


</launch>
