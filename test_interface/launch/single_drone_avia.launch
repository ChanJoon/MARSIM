<launch>
    <arg name="use_gpu_" value="false"/>

    <!-- Branch 4: controller_type=pid runs cascadePID_node (default, byte-identical).
         controller_type=so3 runs the Lee 2010 geometric controller instead. -->
    <arg name="controller_type" default="pid"/>

    <arg name="drone_num" value="1"/>

    <arg name="frame_id" value="world"/>
    <arg name="global_cloud_topic" value="/map_generator/global_cloud"/>
    <arg name="odom_topic" value="/lidar_slam/odom"/>

    <arg name="map_name" value="$(find map_generator)/resource/small_forest01cutoff.pcd"/>
    <arg name="downsample_resolution" value="0.1"/>

    <arg name="use_uav_extra_model" value = "1"/>

    <!-- Branch 2: random map generation. -->
    <!-- map_mode is static or random. static reproduces the legacy golden path. -->
    <!-- scene_type selects the random backend: -->
    <!--   0 simple cylinder forest (no extra deps) -->
    <!--   1 perlin3D cave   2 random columns   3 maze2D   4 Maze3D -->
    <!--   5 tree forest (yopo_tree.ply)   6 room   7 walls -->
    <arg name="map_mode"                 default="static"/>
    <arg name="scene_type"               default="0"/>
    <arg name="map_seed"                 default="0"/>
    <arg name="random_map_size_x"        default="40.0"/>
    <arg name="random_map_size_y"        default="40.0"/>
    <arg name="random_map_size_z"        default="3.0"/>
    <arg name="random_obstacle_num"      default="120"/>
    <arg name="random_keepout_radius"    default="2.0"/>
    <arg name="random_pcd_out"           default="$(find map_generator)/resource/_scratch_random_map.pcd"/>
    <!-- YOPO scene knobs (defaults mirror YOPO's Simulator/src/config/config.yaml) -->
    <arg name="yopo_complexity"          default="0.02"/>
    <arg name="yopo_fill"                default="0.1"/>
    <arg name="yopo_fractal"             default="1"/>
    <arg name="yopo_attenuation"         default="0.1"/>
    <arg name="yopo_width_min"           default="0.6"/>
    <arg name="yopo_width_max"           default="1.5"/>
    <arg name="yopo_obstacle_number"     default="100"/>
    <arg name="yopo_road_width"          default="3.0"/>
    <arg name="yopo_add_wall_x"          default="1"/>
    <arg name="yopo_add_wall_y"          default="1"/>
    <arg name="yopo_tree_dist"           default="4.0"/>
    <arg name="yopo_room_number"         default="4"/>
    <arg name="yopo_max_windows"         default="2"/>
    <arg name="yopo_add_ceiling"         default="0"/>
    <arg name="yopo_window_size_min"     default="2.0"/>
    <arg name="yopo_window_size_max"     default="2.8"/>
    <arg name="yopo_wall_width_min"      default="0.5"/>
    <arg name="yopo_wall_width_max"      default="6.0"/>
    <arg name="yopo_wall_thick"          default="0.5"/>
    <arg name="yopo_wall_number"         default="100"/>
    <arg name="yopo_wall_ceiling"        default="1"/>

    <!-- Branch 1: conditional ground plane. Off by default => byte-identical
         to the legacy golden path. When true, a dense z=ground_z grid is
         injected into the published global_map cloud so both renderers
         (CPU pcl_render_node, GPU opengl_render_node via scratch PCD)
         see a floor and planners avoid it. -->
    <arg name="use_ground_plane"  default="false"/>
    <arg name="ground_resolution" default="0.1"/>
    <arg name="ground_size_x"     default="$(arg random_map_size_x)"/>
    <arg name="ground_size_y"     default="$(arg random_map_size_y)"/>
    <arg name="ground_z"          default="0.0"/>

    <group if="$(eval arg('map_mode') == 'static')">
       <node pkg="map_generator" name="map_pub" type="map_pub" output="screen"
             args="$(arg map_name)">
            <param name="add_boundary" value="0"/>
            <param name="is_bridge" value="0"/>
            <param name="downsample_res" value="0.1"/>
            <param name="map_offset_x" value="0.0"/>
            <param name="map_offset_y" value="0.0"/>
            <param name="map_offset_z" value="0.0"/>
            <param name="use_ground_plane"  value="$(eval 1 if arg('use_ground_plane') else 0)"/>
            <param name="ground_resolution" value="$(arg ground_resolution)"/>
            <param name="ground_size_x"     value="$(arg ground_size_x)"/>
            <param name="ground_size_y"     value="$(arg ground_size_y)"/>
            <param name="ground_z"          value="$(arg ground_z)"/>
       </node>

        <group if="$(arg use_gpu_)">
            <node pkg="map_generator" name="map_pub1" type="map_pub" output="screen"
                    args="$(arg map_name)">
                    <param name="downsample_res" value="0.1"/>
                    <param name="map_offset_x" value="0.0"/>
                    <param name="map_offset_y" value="0.0"/>
                    <param name="map_offset_z" value="0.0"/>
            </node>
        </group>
        <group unless="$(arg use_gpu_)">
            <node pkg="map_generator" name="map_pub2" type="map_pub" output="screen"
                    args="$(arg map_name)">
                    <param name="downsample_res" value="$(arg downsample_resolution)"/>
                    <param name="map_offset_x" value="0.0"/>
                    <param name="map_offset_y" value="0.0"/>
                    <param name="map_offset_z" value="0.0"/>
            </node>
        </group>
    </group>

    <group if="$(eval arg('map_mode') == 'random')">
        <node pkg="map_generator" name="random_map_node" type="random_map_node" output="screen">
            <param name="seed"                value="$(arg map_seed)"/>
            <param name="scene_type"          value="$(arg scene_type)"/>
            <param name="map_size_x"          value="$(arg random_map_size_x)"/>
            <param name="map_size_y"          value="$(arg random_map_size_y)"/>
            <param name="map_size_z"          value="$(arg random_map_size_z)"/>
            <param name="obstacle_num"        value="$(arg random_obstacle_num)"/>
            <param name="keepout_radius"      value="$(arg random_keepout_radius)"/>
            <param name="resolution"          value="$(arg downsample_resolution)"/>
            <param name="pcd_out_path"        value="$(arg random_pcd_out)"/>
            <!-- YOPO scene params (used when scene_type >= 1) -->
            <param name="complexity"          value="$(arg yopo_complexity)"/>
            <param name="fill"                value="$(arg yopo_fill)"/>
            <param name="fractal"             value="$(arg yopo_fractal)"/>
            <param name="attenuation"         value="$(arg yopo_attenuation)"/>
            <param name="width_min"           value="$(arg yopo_width_min)"/>
            <param name="width_max"           value="$(arg yopo_width_max)"/>
            <param name="obstacle_number"     value="$(arg yopo_obstacle_number)"/>
            <param name="road_width"          value="$(arg yopo_road_width)"/>
            <param name="add_wall_x"          value="$(arg yopo_add_wall_x)"/>
            <param name="add_wall_y"          value="$(arg yopo_add_wall_y)"/>
            <param name="tree_dist"           value="$(arg yopo_tree_dist)"/>
            <param name="room_number"         value="$(arg yopo_room_number)"/>
            <param name="max_windows"         value="$(arg yopo_max_windows)"/>
            <param name="add_ceiling"         value="$(arg yopo_add_ceiling)"/>
            <param name="window_size_min"     value="$(arg yopo_window_size_min)"/>
            <param name="window_size_max"     value="$(arg yopo_window_size_max)"/>
            <param name="wall_width_min"      value="$(arg yopo_wall_width_min)"/>
            <param name="wall_width_max"      value="$(arg yopo_wall_width_max)"/>
            <param name="wall_thick"          value="$(arg yopo_wall_thick)"/>
            <param name="wall_number"         value="$(arg yopo_wall_number)"/>
            <param name="wall_ceiling"        value="$(arg yopo_wall_ceiling)"/>
            <!-- Branch 1: ground plane pass-through. -->
            <param name="use_ground_plane"    value="$(arg use_ground_plane)"/>
            <param name="ground_resolution"   value="$(arg ground_resolution)"/>
            <param name="ground_z"            value="$(arg ground_z)"/>
        </node>
    </group>

    <include file="$(find test_interface)/launch/single_drone.xml">
        <arg name="drone_id" value="0"/>
        <arg name="uav_num_" value="$(arg drone_num)"/>
        <arg name="lidar_type" value="avia"/>
        <arg name="init_x_" value="0.0"/>
        <arg name="init_y_" value="0.0"/>
        <arg name="init_z_" value="1.0"/>
        <arg name="init_yaw" value="0.0"/>
        <arg name="map_name_" value="$(eval arg('random_pcd_out') if arg('map_mode') == 'random' else arg('map_name'))"/>
        <arg name="downsample_resolution_" value="$(arg downsample_resolution)"/>
        <arg name="odom_topic" value="$(arg odom_topic)"/>
        <arg name="use_gpu" value="$(arg use_gpu_)"/>
        <arg name="use_uav_extra_model_" value="$(arg use_uav_extra_model)"/>
        <arg name="controller_type" value="$(arg controller_type)"/>
    </include>

   <node name="rvizvisualisation" pkg="rviz" type="rviz" output="screen"
   args="-d $(find test_interface)/config/traj.rviz" />

</launch>